# Local demo only. Copy to root .env; never commit real secrets.
APP_MODE=demo
APP_URL=http://localhost:3000
POSTGRES_DB=devmentor
POSTGRES_USER=devmentor
POSTGRES_PASSWORD=devmentor_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://devmentor:devmentor_local@127.0.0.1:5432/devmentor
# Local convenience only. Production uses separate least-privilege runtime roles.
AUTH_DATABASE_URL=postgresql://devmentor:devmentor_local@127.0.0.1:5432/devmentor
MIGRATION_DATABASE_URL=postgresql://devmentor:devmentor_local@127.0.0.1:5432/devmentor
AUTH_MIGRATION_DATABASE_URL=postgresql://devmentor:devmentor_local@127.0.0.1:5432/devmentor
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_AUTH_POOL_MAX=5
# Required outside demo: >=32 random characters from a secret manager.
# AUTH_SECRET=
# SMTP_URL=smtps://username:password@smtp.example.test:465
EMAIL_FROM=DevMentor <noreply@example.test>
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MEETING_BASE_URL=https://meeting.example.test/room
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Optional paired OAuth credentials; never exposed by /api/v1/config.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
