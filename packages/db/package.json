    "dotenv": "17.4.2",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.6",
    "tsx": "4.23.15"
  },
  "mikro-orm": {
