{
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "name": "@devmentor/db",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "orm": "mikro-orm",
    "check": "tsx src/check.ts"
  },
  "dependencies": {
    "@devmentor/core": "*",
    "@mikro-orm/core": "7.2.6",
    "@mikro-orm/postgresql": "7.2.6",
