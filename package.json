{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@devmentor/app",
    "build": "npm run build --workspace=@devmentor/app",
    "start": "npm run start --workspace=@devmentor/app",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "db:check": "npm run check --workspace=@devmentor/db",
    "db:debug": "npm run orm --workspace=@devmentor/db -- debug",
    "db:migration:create": "npm run orm --workspace=@devmentor/db -- migration:create",
    "db:migrate": "npm run orm --workspace=@devmentor/db -- migration:up",
    "db:migration:list": "npm run orm --workspace=@devmentor/db -- migration:list",
    "db:up": "docker compose up --wait --wait-timeout 120 postgres",
    "db:down": "docker compose stop postgres",
    "ui:add": "shadcn add --cwd packages/app",
    "db:migration:down": "npm run orm --workspace=@devmentor/db -- migration:down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "tsx scripts/check-dependencies.ts",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run deps:check && npm run test:coverage",
    "security:check": "tsx scripts/check-audit.ts",
    "worker": "tsx --conditions=react-server packages/app/scripts/worker.ts",
    "migrate": "tsx --conditions=react-server packages/app/scripts/migrate.ts",
    "seed:demo": "tsx --conditions=react-server packages/app/scripts/seed-demo.ts",
    "test:e2e:docker": "tsx scripts/e2e.ts --docker",
    "test:app": "node --conditions=react-server --import tsx tests/support/serve-app.ts",
    "test:browser:install": "node node_modules/agent-browser/scripts/postinstall.js && agent-browser install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testcontainers/postgresql": "12.2.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "agent-browser": "0.41.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "packageManager": "npm@11.20.0"
}
