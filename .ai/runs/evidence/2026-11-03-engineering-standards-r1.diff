+  text-align: left;
+}
+.data-table th,
+.data-table td {
+  border-bottom: 1px solid var(--border);
+  padding: 14px;
+  vertical-align: top;
+}
+.data-table th {
+  background: #edf0e6;
+  font-weight: 650;
+}
+.dialog-overlay {
+  position: fixed;
+  inset: 0;
+  background: #10241870;
+  z-index: 50;
+  display: grid;
+  place-items: center;
+  padding: 20px;
+}
+.dialog-content {
+  background: var(--background);
+  padding: 28px;
+  border-radius: 20px;
+  max-width: 520px;
+  width: 100%;
+  max-height: 90vh;
+  overflow: auto;
+}
+.skeleton {
+  min-height: 90px;
+  background: linear-gradient(90deg, #eef0e8, #fff, #eef0e8);
+}
+.date-card {
+  font-size: 13px;
+  background: #eaf0df;
+  border-radius: 12px;
+  padding: 18px;
+  margin: 16px 0;
+}
+.subtle {
+  font-size: 12px;
+  color: var(--muted-foreground);
+}
+.prose-copy {
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
+.rating {
+  font-size: 14px;
+  color: #556a2d;
+}
+.empty-state {
+  text-align: center;
+  padding: 48px 24px;
+  border: 1px dashed #bdcbb3;
+  border-radius: 18px;
+}
+.empty-state h2 {
+  font-size: 22px;
+  margin-bottom: 12px;
+}
+@media (max-width: 1000px) {
+  .hero {
+    gap: 30px;
+  }
+  .hero-art {
+    padding: 24px;
+    min-height: 380px;
+  }
+  .growth-line {
