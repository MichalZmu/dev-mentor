+  }
+  .site-footer nav {
+    gap: 16px;
+    flex-wrap: wrap;
+  }
+  .mentor-grid {
+    grid-template-columns: 1fr;
+  }
+  .filters {
+    grid-template-columns: 1fr;
+    padding: 18px;
+  }
+  .filters > :first-child {
+    grid-column: auto;
