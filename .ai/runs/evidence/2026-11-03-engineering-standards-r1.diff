+    grid-column: auto;
+  }
+  .profile-title {
+    gap: 16px;
+  }
+  .profile-title h1 {
+    font-size: 28px;
+  }
+  .metric-grid {
+    grid-template-columns: 1fr;
+  }
+  .metric {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+  }
+  .profile-grid {
+    gap: 20px;
+  }
+  .page-heading {
+    padding-block: 32px 24px;
+  }
+  .slot-grid {
+    grid-template-columns: 1fr 1fr;
+  }
+  .growth-line span {
+    padding: 13px 10px;
+  }
+  .growth-line i {
+    font-size: 20px;
+  }
+  .orbit-label {
+    font-size: 20px;
