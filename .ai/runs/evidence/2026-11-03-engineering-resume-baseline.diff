+                      <option value="resolve">Rozwiąż zgłoszenie pomocy</option>
+                    )}
+                  </select>
+                </Field>
+                <Field label="Uzasadnienie decyzji (10–1000 znaków)">
+                  <Textarea
+                    name="reason"
+                    required
+                    minLength={10}
