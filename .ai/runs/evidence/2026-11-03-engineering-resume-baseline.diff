+function markdown(text,prefix){const lines=text.split('\n');let html='',list=false,table=false;for(let i=0;i<lines.length;i++){let line=lines[i];if(line.startsWith('|')){if(!table){html+='<div class="table"><table>';table=true;}if(/^\|[\s:|-]+\|$/.test(line))continue;const head=lines[i+1]&&/^\|[\s:|-]+\|$/.test(lines[i+1]),tag=head?'th':'td';html+='<tr>'+line.slice(1,-1).split('|').map(c=>'<'+tag+'>'+inline(c.trim())+'</'+tag+'>').join('')+'</tr>';continue;}if(table){html+='</table></div>';table=false;}if(line.startsWith('- ')){if(!list){html+='<ul>';list=true;}html+='<li>'+inline(line.slice(2))+'</li>';continue;}if(list){html+='</ul>';list=false;}if(!line.trim())continue;const h=line.match(/^(#{1,4}) (.+)/);if(h){const level=Math.min(h[1].length+1,5),id=prefix+'-'+i;html+='<h'+level+' id="'+id+'">'+inline(h[2])+'</h'+level+'>';continue;}html+='<p>'+inline(line)+'</p>';}if(list)html+='</ul>';if(table)html+='</table></div>';return html;}
+const docs=[['concept','Koncepcja i przepływy','01-koncepcja.md'],['screens','Katalog ekranów','02-ekrany.md'],['api','Projekt API','03-api.md'],['qa','Weryfikacja','04-weryfikacja.md']];
