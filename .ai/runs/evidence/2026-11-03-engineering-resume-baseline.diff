+{
+  "openapi": "3.1.0",
+  "info": {
+    "title": "DevMentor API",
+    "version": "1.0.0",
+    "description": "Financial amounts are strings of minor units. UTC timestamps plus IANA timezones. No private cache. Errors are stable codes, never SQL/stacks. Native BetterAuth endpoints /api/auth/* expose email verification, MFA and confirmed email change; direct signup is restricted to versioned register wrapper."
+  },
+  "servers": [
+    {
+      "url": "/api/v1"
+    }
+  ],
+  "components": {
+    "securitySchemes": {
+      "sessionCookie": {
+        "type": "apiKey",
+        "in": "cookie",
+        "name": "better-auth.session_token",
+        "description": "HttpOnly session. Production uses __Secure- cookie prefix and requires verified email; administrative endpoints require session-bound MFA."
+      }
+    },
+    "schemas": {
+      "Money": {
+        "type": "object",
+        "properties": {
+          "amountMinor": {
+            "type": "string",
+            "pattern": "^[0-9]+$"
+          },
+          "currency": {
+            "type": "string",
+            "enum": [
+              "PLN"
+            ]
+          }
+        },
+        "additionalProperties": false
+      },
+      "UserProfile": {
+        "type": "object",
+        "properties": {
+          "id": {
+            "type": "string"
+          },
+          "name": {
+            "type": "string"
+          },
+          "email": {
+            "type": "string",
+            "format": "email"
+          },
+          "timezone": {
+            "type": "string"
+          },
+          "roles": {
+            "type": "array",
+            "items": {
+              "type": "string",
+              "enum": [
+                "mentee",
+                "mentor",
+                "support",
+                "moderator",
+                "admin"
