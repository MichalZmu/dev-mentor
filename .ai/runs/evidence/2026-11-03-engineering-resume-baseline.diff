+  const identities = {
+    menteeId: "mentee",
+    mentorId: "mentor",
+    adminId: "admin",
+  };
+  await expect(seedDemoPlatform(em, identities)).resolves.toEqual({
+    mentorId: "demo-mentor",
+    bookingId: "demo-completed-session",
