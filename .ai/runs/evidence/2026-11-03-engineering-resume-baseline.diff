diff --git a/scripts/check-audit.ts b/scripts/check-audit.ts
new file mode 100644
index 0000000..758bdb1
--- /dev/null
+++ b/scripts/check-audit.ts
@@ -0,0 +1,129 @@
+import { spawnSync } from "node:child_process";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+interface Exception {
+  id: string;
+  owner: string;
+  reason: string;
+  expires: string;
+}
+function record(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Only explicitly listed, unexpired, development-only advisories may be accepted. */
+export function assessAudit(
+  audit: unknown,
+  lock: unknown,
+  exceptions: readonly Exception[],
+  now: Date,
+): string[] {
+  const errors: string[] = [];
+  if (
+    !record(audit) ||
+    audit.error ||
+    !record(audit.vulnerabilities) ||
+    !record(audit.metadata) ||
+    !record(audit.metadata.vulnerabilities) ||
+    typeof audit.metadata.vulnerabilities.total !== "number"
+  )
+    return ["Invalid or unavailable npm audit report"];
+  if (!record(lock) || !record(lock.packages))
+    return ["Invalid lockfile metadata"];
+  const packages = lock.packages;
+  const accepted = new Map<string, Exception>();
+  for (const exception of exceptions) {
+    if (
+      !/^GHSA-[a-z0-9-]+$/.test(exception.id) ||
+      !exception.owner.trim() ||
+      !exception.reason.trim() ||
+      !/^\d{4}-\d{2}-\d{2}$/.test(exception.expires) ||
+      !Number.isFinite(Date.parse(exception.expires + "T00:00:00Z"))
+    ) {
+      errors.push("Incomplete security exception metadata");
+      continue;
+    }
+    if (now >= new Date(exception.expires + "T00:00:00Z"))
+      errors.push(`Security exception expired: ${exception.id}`);
+    accepted.set(exception.id, exception);
+  }
+  for (const [name, value] of Object.entries(audit.vulnerabilities)) {
+    if (
+      !record(value) ||
+      !Array.isArray(value.via) ||
+      !Array.isArray(value.nodes) ||
+      value.nodes.length === 0
+    ) {
+      errors.push(`Missing vulnerability metadata: ${name}`);
+      continue;
+    }
+    const devOnly = value.nodes.every(
+      (node: unknown) =>
+        typeof node === "string" &&
+        record(packages[node]) &&
+        packages[node].dev === true,
+    );
+    if (!devOnly)
+      errors.push(`Vulnerable runtime or unclassified dependency: ${name}`);
+    for (const via of value.via) {
+      if (typeof via === "string") {
+        if (!Object.hasOwn(audit.vulnerabilities, via))
+          errors.push(`Unresolved advisory chain: ${name}`);
+      } else if (record(via) && typeof via.url === "string") {
+        const match =
+          /^https:\/\/github\.com\/advisories\/(GHSA-[a-z0-9-]+)$/.exec(
+            via.url,
+          );
+        const id = match?.[1];
+        if (!id || !accepted.has(id))
+          errors.push(`Unaccepted advisory: ${id ?? name}`);
+      } else errors.push(`Missing advisory identity: ${name}`);
+    }
+  }
+  return errors;
+}
+function audit(omitDev: boolean): unknown {
+  const result = spawnSync(
+    "npm",
+    ["audit", "--json", ...(omitDev ? ["--omit=dev"] : [])],
+    { encoding: "utf8", maxBuffer: 10 * 1024 * 1024 },
+  );
+  if (result.error || (result.status !== 0 && result.status !== 1))
+    throw new Error("npm audit could not complete");
+  try {
+    return JSON.parse(result.stdout) as unknown;
+  } catch {
+    throw new Error("npm audit returned invalid JSON");
+  }
+}
+export function checkAudit(): void {
+  const lock: unknown = JSON.parse(readFileSync("package-lock.json", "utf8"));
+  const exceptions = JSON.parse(
+    readFileSync("security-exceptions.json", "utf8"),
+  ) as Exception[];
+  const runtime = audit(true);
+  const full = audit(false);
+  const errors = [
+    ...assessAudit(runtime, lock, [], new Date()),
+    ...assessAudit(full, lock, exceptions, new Date()),
+  ];
+  for (const error of errors) console.error(error);
+  if (errors.length) process.exitCode = 1;
+  else
+    console.log(
+      "Audit passed: runtime clean; only documented, unexpired development exceptions.",
+    );
+}
+if (
+  process.argv[1] &&
+  resolve(process.argv[1]) === fileURLToPath(import.meta.url)
+) {
+  try {
+    checkAudit();
+  } catch {
+    console.error("Security check failed: audit or metadata unavailable.");
+    process.exitCode = 1;
+  }
+}
diff --git a/scripts/check-dependencies.ts b/scripts/check-dependencies.ts
new file mode 100644
index 0000000..609c20c
--- /dev/null
+++ b/scripts/check-dependencies.ts
@@ -0,0 +1,246 @@
+import { existsSync, readFileSync, readdirSync } from "node:fs";
+import { dirname, extname, relative, resolve, sep } from "node:path";
+import { fileURLToPath } from "node:url";
+import ts from "typescript";
+
+type PackageName = "app" | "core" | "db" | "ui";
+interface PackageManifest {
+  exports?: Record<string, string>;
+  dependencies?: Record<string, string>;
+  devDependencies?: Record<string, string>;
+  peerDependencies?: Record<string, string>;
+}
+const packageNames: PackageName[] = ["app", "core", "db", "ui"];
+const allowed: Record<PackageName, readonly PackageName[]> = {
+  app: ["core", "db", "ui"],
+  core: [],
+  db: ["core"],
+  ui: [],
+};
+const ignored = new Set(["node_modules", ".next", "dist", "build"]);
+
+function sourceFiles(directory: string): string[] {
+  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
+    if (ignored.has(entry.name)) return [];
+    const path = resolve(directory, entry.name);
+    return entry.isDirectory()
+      ? sourceFiles(path)
+      : /\.[cm]?[jt]sx?$/.test(path) &&
+          !path.endsWith(".d.ts") &&
+          !path.endsWith("next-env.d.ts")
+        ? [path]
+        : [];
+  });
+}
+function packageOf(root: string, path: string): PackageName | undefined {
+  const parts = relative(resolve(root, "packages"), path).split(sep);
+  return packageNames.find((name) => name === parts[0]);
+}
+function resolveFile(path: string): string | undefined {
+  // Source imports may use their eventual .js extension under Node ESM.
+  const base = /\.[cm]?js$/.test(path) ? path.replace(/\.[cm]?js$/, "") : path;
+  return [
+    path,
+    base + ".ts",
+    base + ".tsx",
+    base + ".mts",
+    base + ".js",
+    resolve(path, "index.ts"),
+    resolve(path, "index.tsx"),
+  ].find((candidate) => existsSync(candidate) && extname(candidate) !== "");
+}
+function exportTarget(
+  manifest: PackageManifest,
+  subpath: string,
+): string | undefined {
+  for (const [key, value] of Object.entries(manifest.exports ?? {})) {
+    if (key === subpath) return value;
+    if (key.includes("*")) {
+      const wildcard = key.indexOf("*");
+      const prefix = key.slice(0, wildcard);
+      const suffix = key.slice(wildcard + 1);
+      if (subpath.startsWith(prefix) && subpath.endsWith(suffix)) {
+        return value.replace(
+          "*",
+          subpath.slice(prefix.length, suffix ? -suffix.length : undefined),
+        );
+      }
+    }
+  }
+  return undefined;
+}
+
+/** Check both the manifest graph and resolved source graph, including type imports. */
+export function checkDependencies(root: string): string[] {
+  const errors: string[] = [];
+  const manifests = new Map<PackageName, PackageManifest>();
+  const graph = new Map<string, string[]>();
+  for (const name of packageNames) {
+    const manifest = JSON.parse(
+      readFileSync(resolve(root, "packages", name, "package.json"), "utf8"),
+    ) as PackageManifest;
+    manifests.set(name, manifest);
+    for (const dependency of Object.keys({
+      ...manifest.dependencies,
+      ...manifest.devDependencies,
+      ...manifest.peerDependencies,
+    })) {
+      if (
+        name === "core" &&
+        /^(?:next|react|react-dom|awilix|server-only|@mikro-orm)(?:\/|$)/.test(
+          dependency,
+        )
+      )
+        errors.push(`core: forbidden infrastructure dependency ${dependency}`);
+      const target = packageNames.find(
+        (entry) => dependency === `@devmentor/${entry}`,
+      );
+      if (target && !allowed[name].includes(target))
+        errors.push(`${name}: forbidden manifest dependency ${dependency}`);
+    }
+  }
+  for (const name of packageNames) {
+    for (const file of sourceFiles(resolve(root, "packages", name))) {
+      const edges: string[] = [];
+      graph.set(file, edges);
+      const parsed = ts.createSourceFile(
+        file,
+        readFileSync(file, "utf8"),
+        ts.ScriptTarget.Latest,
+        true,
+      );
+      function inspect(specifier: string): void {
+        const location = relative(root, file);
+        let target: string | undefined;
+        if (
+          name === "core" &&
+          /^(?:next|react|react-dom|awilix|server-only|@mikro-orm)(?:\/|$)/.test(
+            specifier,
+          )
+        )
+          errors.push(`${location}: core infrastructure import ${specifier}`);
+        if (
+          name === "ui" &&
+          /^(?:awilix|server-only|@mikro-orm)(?:\/|$)/.test(specifier)
+        )
+          errors.push(`${location}: UI server import ${specifier}`);
+        if (
+          (specifier.startsWith("@devmentor/") || specifier.startsWith("@/")) &&
+          specifier.split("/").some((part) => part === ".." || part === ".")
+        ) {
+          errors.push(`${location}: package alias traversal ${specifier}`);
+          return;
+        }
+        if (specifier.startsWith("@devmentor/")) {
+          const targetName = packageNames.find(
+            (entry) =>
+              specifier === `@devmentor/${entry}` ||
+              specifier.startsWith(`@devmentor/${entry}/`),
+          );
+          if (!targetName) {
+            errors.push(`${location}: unknown internal package ${specifier}`);
+            return;
+          }
+          const manifest = manifests.get(targetName);
+          const subpath = specifier.slice(`@devmentor/${targetName}`.length);
+          const exported =
+            manifest && exportTarget(manifest, subpath ? `.${subpath}` : ".");
+          if (!exported) {
+            errors.push(`${location}: non-public package import ${specifier}`);
+            return;
+          }
+          target = resolveFile(resolve(root, "packages", targetName, exported));
+          if (!target)
+            errors.push(`${location}: unresolved package export ${specifier}`);
+        } else if (specifier.startsWith(".")) {
+          target = resolveFile(resolve(dirname(file), specifier));
+          if (!target)
+            errors.push(`${location}: unresolved relative import ${specifier}`);
+          if (target && packageOf(root, target) !== name)
+            errors.push(
+              `${location}: relative import crosses package boundary ${specifier}`,
+            );
+        } else if (specifier.startsWith("@/")) {
+          target = resolveFile(
+            resolve(root, "packages", name, specifier.slice(2)),
+          );
+          if (!target)
+            errors.push(`${location}: unresolved local alias ${specifier}`);
+          // Traversal segments were rejected above; @/ stays inside this package.
+        }
+        if (target) {
+          const targetName = packageOf(root, target);
+          if (
+            targetName &&
+            targetName !== name &&
+            !allowed[name].includes(targetName)
+          )
+            errors.push(`${location}: forbidden ${name} -> ${targetName}`);
+          edges.push(target);
+        }
+      }
+      function visit(node: ts.Node): void {
+        if (
+          (ts.isImportDeclaration(node) || ts.isExportDeclaration(node)) &&
+          node.moduleSpecifier &&
+          ts.isStringLiteral(node.moduleSpecifier)
+        )
+          inspect(node.moduleSpecifier.text);
+        if (
+          ts.isImportTypeNode(node) &&
+          ts.isLiteralTypeNode(node.argument) &&
+          ts.isStringLiteral(node.argument.literal)
+        )
+          inspect(node.argument.literal.text);
+        if (
+          ts.isImportEqualsDeclaration(node) &&
+          ts.isExternalModuleReference(node.moduleReference) &&
+          node.moduleReference.expression &&
+          ts.isStringLiteral(node.moduleReference.expression)
+        )
+          inspect(node.moduleReference.expression.text);
+        if (
+          ts.isCallExpression(node) &&
+          (node.expression.kind === ts.SyntaxKind.ImportKeyword ||
+            (ts.isIdentifier(node.expression) &&
+              node.expression.text === "require"))
+        ) {
+          const argument = node.arguments[0];
+          if (argument && ts.isStringLiteralLike(argument))
+            inspect(argument.text);
+          else
+            errors.push(
+              `${relative(root, file)}: non-literal module import cannot be checked`,
+            );
+        }
+        ts.forEachChild(node, visit);
+      }
+      visit(parsed);
+    }
+  }
+  const visited = new Set<string>();
+  const active = new Set<string>();
+  function traverse(file: string): void {
+    if (active.has(file)) {
+      errors.push(`dependency cycle at ${relative(root, file)}`);
+      return;
+    }
+    if (visited.has(file)) return;
+    visited.add(file);
+    active.add(file);
+    for (const target of graph.get(file) ?? []) traverse(target);
+    active.delete(file);
+  }
+  for (const file of graph.keys()) traverse(file);
+  return errors;
+}
+
+if (
+  process.argv[1] &&
+  resolve(process.argv[1]) === fileURLToPath(import.meta.url)
+) {
+  const errors = checkDependencies(process.cwd());
+  for (const error of errors) console.error(error);
+  if (errors.length) process.exitCode = 1;
+  else console.log("Package boundaries, public exports and source cycles OK.");
+}
diff --git a/scripts/e2e.ts b/scripts/e2e.ts
new file mode 100644
index 0000000..913ec2f
--- /dev/null
+++ b/scripts/e2e.ts
@@ -0,0 +1,144 @@
+import { spawn, type ChildProcess } from "node:child_process";
+import { dirname, resolve } from "node:path";
+import { setTimeout } from "node:timers/promises";
+import { PostgreSqlContainer } from "@testcontainers/postgresql";
+
+const root = process.cwd();
+const port = 3100;
+const baseURL = `http://localhost:${port}`;
+const children: ChildProcess[] = [];
+function run(
+  command: string,
+  args: string[],
+  env: NodeJS.ProcessEnv,
+): Promise<void> {
+  return new Promise((resolvePromise, reject) => {
+    const child = spawn(command, args, { cwd: root, env, stdio: "inherit" });
+    child.once("error", reject);
+    child.once("exit", (code) =>
+      code === 0
+        ? resolvePromise()
+        : reject(new Error("Verification command failed")),
+    );
+  });
+}
+async function stop(child: ChildProcess): Promise<void> {
+  if (child.exitCode !== null) return;
+  child.kill("SIGTERM");
+  await Promise.race([
+    new Promise<void>((resolvePromise) =>
+      child.once("exit", () => resolvePromise()),
+    ),
+    setTimeout(3000),
+  ]);
+  if (child.exitCode === null) child.kill("SIGKILL");
+}
+const container = await new PostgreSqlContainer("postgres:18.6")
+  .withDatabase("devmentor_e2e")
+  .start();
+const env = {
+  ...process.env,
+  APP_MODE: "demo",
+  APP_URL: baseURL,
+  DATABASE_URL: container.getConnectionUri(),
+  AUTH_DATABASE_URL: container.getConnectionUri(),
+  MIGRATION_DATABASE_URL: container.getConnectionUri(),
+  AUTH_MIGRATION_DATABASE_URL: container.getConnectionUri(),
+  AUTH_SECRET: "e2e-only-not-a-production-secret-2026",
+  PLAYWRIGHT_BASE_URL: baseURL,
+  PLAYWRIGHT_EXTERNAL_SERVER: "1",
+};
+try {
+  await run("npm", ["run", "migrate"], env);
+  await run("npm", ["run", "seed:demo"], env);
+  const worker = spawn(
+    process.execPath,
+    [
+      resolve("node_modules/tsx/dist/cli.mjs"),
+      "--conditions=react-server",
+      "packages/app/scripts/worker.ts",
+    ],
+    { cwd: root, env, stdio: ["ignore", "ignore", "pipe"] },
+  );
+  children.push(worker);
+  worker.stderr?.on("data", () => {
+    /* Worker logs are safe, but avoid flooding the E2E output. */
+  });
+  const server = spawn(
+    process.execPath,
+    [
+      resolve("node_modules/next/dist/bin/next"),
+      "start",
+      "packages/app",
+      "--hostname",
+      "0.0.0.0",
+      "--port",
+      String(port),
+    ],
+    { cwd: root, env, stdio: ["ignore", "inherit", "inherit"] },
+  );
+  children.push(server);
+  const deadline = Date.now() + 60_000;
+  let ready = false;
+  while (Date.now() < deadline) {
+    if (server.exitCode !== null || worker.exitCode !== null)
+      throw new Error("E2E service terminated before readiness");
+    try {
+      const result = await fetch(baseURL + "/api/v1/health");
+      if (result.ok) {
+        ready = true;
+        break;
+      }
+    } catch {
+      /* Readiness probe retries until the bounded deadline. */
+    }
+    await setTimeout(100);
+  }
+  if (!ready) throw new Error("E2E web server did not become ready");
+  if (process.argv.includes("--docker")) {
+    const nodeRoot = dirname(dirname(process.execPath));
+    await run(
+      "docker",
+      [
+        "run",
+        "--rm",
+        "--user",
+        `${process.getuid?.() ?? 1000}:${process.getgid?.() ?? 1000}`,
+        "--network",
+        "host",
+        "--ipc",
+        "host",
+        "-v",
+        `${root}:/workspace`,
+        "-v",
+        `${nodeRoot}:/opt/node:ro`,
+        "-e",
+        "PATH=/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
+        "-e",
+        "PLAYWRIGHT_EXTERNAL_SERVER=1",
+        "-e",
+        `PLAYWRIGHT_BASE_URL=${baseURL}`,
+        "-w",
+        "/workspace",
+        "mcr.microsoft.com/playwright:v1.64.1-noble",
+        "node",
+        "node_modules/@playwright/test/cli.js",
+        "test",
+      ],
+      env,
+    );
+  } else
+    await run(
+      process.execPath,
+      [resolve("node_modules/@playwright/test/cli.js"), "test"],
+      env,
+    );
+} catch {
+  console.error(
+    "Product E2E failed; inspect the test reports and service error codes.",
+  );
+  process.exitCode = 1;
+} finally {
+  await Promise.all(children.map(stop));
+  await container.stop();
+}
