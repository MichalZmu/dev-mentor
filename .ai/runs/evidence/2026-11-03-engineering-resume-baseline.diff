+export type Role = "mentee" | "mentor" | "moderator" | "support" | "admin";
+export interface Actor {
+  id: string;
+  roles: Role[];
+  mfaVerified: boolean;
+  requestId?: string;
+}
+export interface Money {
+  amountMinor: string;
+  currency: string;
+}
+export type BookingState =
+  "held" | "confirmed" | "completed" | "expired" | "cancelled";
+export type PaymentState = "pending" | "paid" | "failed";
+export type RefundState =
+  "none" | "requested" | "pending" | "succeeded" | "failed";
+export interface Page<T> {
+  data: T[];
+  nextCursor: string | null;
+}
+export interface UserProfile {
+  id: string;
+  name: string;
+  email: string;
+  timezone: string;
+  roles: Role[];
+  preferences: Record<string, unknown>;
+  version: number;
+}
+export interface Mentor {
+  id: string;
+  userId: string;
+  name: string;
+  headline: string;
+  bio: string;
+  specialty: string;
+  languages: string[];
+  priceMinor: string;
+  currency: string;
+  years: number;
+  rating: number;
+  status: string;
+  version: number;
+}
+export interface AvailabilitySlot {
+  id: string;
+  mentorId: string;
+  startsAt: string;
+  endsAt: string;
+  timezone: string;
+  available: boolean;
+}
+export interface Booking {
+  id: string;
+  mentorId: string;
+  menteeId: string;
+  mentorUserId: string;
+  startsAt: string;
+  endsAt: string;
+  timezone: string;
+  state: BookingState;
+  expiresAt: string;
+  amountMinor: string;
+  currency: string;
+  feeMinor: string;
+  paymentState: PaymentState;
+  refundState: RefundState;
+  checkoutUrl: string | null;
+  checkoutId: string | null;
+  version: number;
+  policyVersion: string;
+  paymentMode: string;
+}
+export interface Conversation {
+  id: string;
+  mentorId: string;
+  menteeId: string;
+  mentorUserId: string;
+  mentorName: string;
+}
+export interface Message {
+  id: string;
+  conversationId: string;
+  senderId: string;
+  text: string;
+  createdAt: string;
+}
+export interface Review {
+  id: string;
+  bookingId: string;
+  authorName: string;
+  rating: number;
+  comment: string;
+  createdAt: string;
+}
+export interface Case {
+  id: string;
+  kind: "mentor_application" | "support";
+  userId: string;
+  status: string;
+  payload: Record<string, unknown>;
+  decisionReason: string | null;
+  version: number;
