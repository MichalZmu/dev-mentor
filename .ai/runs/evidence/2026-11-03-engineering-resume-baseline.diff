+            amountMinor: item.amountMinor,
+            currency: item.currency,
+            paymentState: item.paymentState,
+            checkoutId: item.checkoutId,
+            checkoutUrl: item.checkoutUrl,
+          });
+          return response(
+            (await service.packages(actor)).find(
+              (value) => value.id === item.id,
+            ),
+            201,
+          );
+        }
+        if (itemId && method === "PATCH") {
+          const input = z
+            .object({
+              action: z.enum(["pause", "resume", "cancel"]),
+              version,
+              autoRenew: z.literal(false).optional(),
+            })
+            .strict()
+            .parse(await jsonBody(request));
+          return response(
+            await service.updatePackage(
+              actor,
+              itemId,
+              input.action,
+              input.version,
+            ),
+          );
+        }
+      }
+      if (resource === "mentor-applications" && method === "POST")
+        return response(
+          await service.applyMentor(
+            actor,
+            mentorInput.parse(await jsonBody(request)) as MentorInput,
+          ),
+          201,
+        );
+      if (resource === "mentor") {
+        if (itemId === "dashboard" && method === "GET")
+          return response({
+            application: await service.ownApplication(actor),
+            profile: actor.roles.includes("mentor")
+              ? await service.ownMentor(actor)
+              : null,
+            sessions: actor.roles.includes("mentor")
+              ? (await service.bookings(actor)).map((booking) =>
+                  sessionForActor(booking, actor),
+                )
+              : [],
+          });
+        if (itemId === "profile" && method === "GET")
+          return response(await service.ownMentor(actor));
+        if (itemId === "profile" && method === "PATCH")
+          return response(
+            await service.saveMentor(
+              actor,
+              mentorInput.parse(await jsonBody(request)) as MentorInput,
+            ),
+          );
+        if (itemId === "availability" && action === "rules" && method === "GET")
+          return response(await service.availabilityRules(actor));
+        if (
+          itemId === "availability" &&
+          action === "rules" &&
+          method === "PUT"
+        ) {
+          const input = z
+            .object({
+              rules: z
+                .array(
+                  z.object({
+                    weekday: z.number().int().min(0).max(6),
+                    localTime: z.string().regex(/^\d{2}:\d{2}$/),
+                    timezone: z.string().max(100),
+                    disambiguation: z
+                      .enum(["earlier", "later", "reject"])
+                      .optional(),
+                  }),
+                )
+                .max(50),
+              exceptions: z
+                .array(
+                  z.object({ localDate: z.iso.date(), available: z.boolean() }),
+                )
+                .max(366),
+            })
+            .strict()
+            .parse(await jsonBody(request));
+          return response(
+            await service.saveAvailabilityRules(
+              actor,
+              input.rules as AvailabilityRule[],
+              input.exceptions as CalendarException[],
+            ),
+          );
+        }
+        if (itemId === "availability" && !action && method === "GET") {
+          const mentor = await service.ownMentor(actor);
+          const range = timeRange(url.searchParams);
+          return response(
+            await service.availability(mentor.id, range.from, range.to),
+          );
+        }
+        if (itemId === "availability" && !action && method === "PUT") {
+          const input = z
+            .object({
+              slots: z.array(slotInput).max(1000),
+              version: version.optional(),
+            })
+            .strict()
+            .parse(await jsonBody(request));
+          return response(
+            await service.saveAvailability(actor, input.slots as SlotInput[]),
+          );
+        }
+        if (itemId === "earnings" && method === "GET")
+          return response(await service.earnings(actor));
+        if (itemId === "payouts" && method === "POST") {
+          const input = z
+            .object({ amountMinor: minor, currency: z.literal("PLN") })
+            .strict()
+            .parse(await jsonBody(request));
+          return response(
+            await service.payout(
+              actor,
+              input.amountMinor,
+              idempotencyKey(request),
+              new Date().toISOString(),
+            ),
+            202,
+          );
+        }
+        if (itemId === "connect" && method === "POST") {
+          requireRole(actor, ["mentor"]);
+          const account = await service.connectAccount(actor);
+          const profile = await service.profile(actor);
+          const result = await connectOnboarding(
+            actor.id,
+            profile.email,
+            account.accountId,
+            runtime.env,
+          );
+          await repository.updateConnectAccount(
+            actor.id,
+            result.accountId,
+            result.ready,
+          );
+          return response({ url: result.url });
+        }
+      }
+      if (resource === "support-tickets" && method === "POST") {
+        const input = z
+          .object({
+            category: z.string().min(1).max(80),
+            description: z.string().min(20).max(2000),
+            sessionId: id.optional(),
+            email: z.email().optional(),
+          })
+          .strict()
+          .parse(await jsonBody(request));
+        return response(
+          await service.support(
+            actor,
+            input.category,
+            input.description,
+            input.sessionId,
+          ),
+          201,
+        );
+      }
+      if (resource === "admin") {
+        if (itemId === "mentor-applications" && method === "GET")
+          return bounded(
+            await service.adminCases(actor, "mentor_application"),
+            url.searchParams,
+          );
+        if (itemId === "support-tickets" && method === "GET")
+          return bounded(
+            await service.adminCases(actor, "support"),
+            url.searchParams,
+          );
+        if (itemId === "overview" && method === "GET") {
+          requireRole(actor, ["support", "moderator", "admin"]);
+          const summary: Record<string, number> = {};
+          if (actor.roles.some((role) => ["admin", "support"].includes(role))) {
+            const supportCases = await service.adminCases(actor, "support");
+            const pending = supportCases.filter(
+              (item) => item.status === "pending",
+            ).length;
+            summary.openTickets = pending;
+            summary.supportOpen = pending;
+            summary.cases = supportCases.length;
+          }
+          if (actor.roles.some((role) => ["admin", "moderator"].includes(role)))
+            summary.pendingApplications = (
+              await service.adminCases(actor, "mentor_application")
+            ).filter((item) => item.status === "pending").length;
+          return response(summary);
+        }
+        if (itemId === "cases" && action && !subitem && method === "GET")
+          return response(await service.caseDetail(actor, action));
+        if (
+          itemId === "cases" &&
+          action &&
+          subitem === "decision" &&
+          method === "POST"
+        ) {
+          const input = z
+            .object({
+              action: z.enum(["approve", "reject", "resolve"]),
+              reason: z.string().min(10).max(1000),
+              version,
+            })
+            .strict()
+            .parse(await jsonBody(request));
+          return response(
+            await service.decideCase(
+              actor,
+              action,
+              input.action,
+              input.reason,
+              input.version,
+              new Date().toISOString(),
+            ),
+          );
+        }
+        if (itemId === "jobs" && !action && method === "GET")
+          return response(await service.failedJobs(actor));
+        if (
+          itemId === "jobs" &&
+          action &&
+          subitem === "retry" &&
+          method === "POST"
+        ) {
+          await service.retryFailedJob(actor, action);
+          return response({ accepted: true }, 202);
+        }
+        if (itemId === "metrics" && method === "GET") {
+          requireRole(actor, ["admin"]);
+          return response(await repository.metrics(new Date().toISOString()));
+        }
+      }
+      throw new DomainError("NOT_FOUND", 404);
+    });
+  } catch (error) {
+    return errorResponse(error, requestId);
+  }
+}
+
+export function handleApi(request: Request): Promise<Response> {
+  return trace
+    .getTracer("devmentor-http")
+    .startActiveSpan("http.request", async (span) => {
+      span.setAttribute("http.request.method", request.method);
+      try {
+        const result = await dispatchApi(request);
+        span.setAttribute("http.response.status_code", result.status);
+        if (result.status >= 500)
+          span.setStatus({
+            code: SpanStatusCode.ERROR,
+            message: "REQUEST_FAILED",
+          });
+        return result;
+      } finally {
+        span.end();
+      }
+    });
+}
diff --git a/packages/app/server/auth-http.ts b/packages/app/server/auth-http.ts
new file mode 100644
index 0000000..311ca81
--- /dev/null
+++ b/packages/app/server/auth-http.ts
@@ -0,0 +1,226 @@
+import "server-only";
+import { createHash, randomBytes } from "node:crypto";
+import { z } from "zod";
+import { DomainError } from "@devmentor/core";
+import { getAuthRuntime } from "./auth";
+import { assertOrigin, empty, errorResponse, jsonBody, response } from "./http";
+import { authenticate, withPlatform } from "./platform";
+
+function cookiesAfter(headers: Headers, result: Headers): Headers {
+  const cookies = new Map<string, string>();
+  for (const entry of (headers.get("cookie") ?? "").split(";")) {
+    const index = entry.indexOf("=");
+    if (index > 0)
+      cookies.set(entry.slice(0, index).trim(), entry.slice(index + 1).trim());
+  }
+  for (const entry of result.getSetCookie()) {
+    const pair = entry.slice(0, (entry + ";").indexOf(";"));
+    const index = pair.indexOf("=");
+    if (index > 0) cookies.set(pair.slice(0, index), pair.slice(index + 1));
+  }
+  const merged = new Headers(headers);
+  merged.set(
+    "cookie",
+    [...cookies].map(([name, value]) => `${name}=${value}`).join("; "),
+  );
+  return merged;
+}
+function mailboxCookie(request: Request): string | undefined {
+  return /(?:^|;\s*)devmentor_demo_mailbox=([a-f0-9]{64})(?:;|$)/.exec(
+    request.headers.get("cookie") ?? "",
+  )?.[1];
+}
+const digest = (value: string): string =>
+  createHash("sha256").update(value).digest("hex");
+export async function handleNativeAuth(request: Request): Promise<Response> {
+  try {
+    const { auth, env, pool } = getAuthRuntime();
+    if (request.method !== "GET") assertOrigin(request, env.APP_URL);
+    const path = new URL(request.url).pathname;
+    if (path.endsWith("/sign-up/email"))
+      return errorResponse(new DomainError("USE_REGISTER_ENDPOINT", 400));
+    if (path.endsWith("/change-email") && env.APP_MODE === "demo") {
+      const session = await auth.api.getSession({ headers: request.headers });
+      const owner = mailboxCookie(request);
+      if (session && owner) {
+        const body = z
+          .object({ newEmail: z.email() })
+          .passthrough()
+          .parse(await request.clone().json());
+        await pool.query(
+          `insert into auth.demo_mailbox_owner(email,owner_hash) select lower($1),$2 where not exists(select 1 from auth."user" where lower(email)=lower($1)) on conflict(email) do nothing`,
+          [body.newEmail, digest(owner)],
+        );
+      }
+    }
+    const result = await auth.handler(request);
+    if (
+      result.ok &&
+      /\/two-factor\/verify-(?:totp|otp|backup-code)$/.test(path)
+    ) {
+      const session = await auth.api.getSession({
+        headers: cookiesAfter(request.headers, result.headers),
+        query: { disableCookieCache: true },
+      });
+      if (session)
+        await pool.query(
+          "insert into auth.mfa_session(session_id, verified_at) values($1,now()) on conflict(session_id) do update set verified_at=excluded.verified_at",
+          [session.session.id],
+        );
+    }
+    if (result.status >= 500)
+      return errorResponse(new Error("Authentication unavailable"));
+    result.headers.set("Cache-Control", "no-store");
+    return result;
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+export async function handleAuthWrapper(
+  request: Request,
+  path: string,
+): Promise<Response> {
+  const { auth, pool, env } = getAuthRuntime();
+  assertOrigin(request, env.APP_URL);
+  const raw = await jsonBody(request);
+  let target = "";
+  let body: Record<string, unknown> = {};
+  let owner: string | undefined;
+  if (path === "login") {
+    body = z
+      .object({ email: z.email(), password: z.string().min(1).max(128) })
+      .strict()
+      .parse(raw);
+    target = "sign-in/email";
+  } else if (path === "register") {
+    const input = z
+      .object({
+        email: z.email().max(254),
+        password: z.string().min(12).max(128),
+        name: z.string().trim().min(2).max(100),
+        termsVersion: z.string().min(1).max(50),
+      })
+      .strict()
+      .parse(raw);
+    body = {
+      email: input.email,
+      password: input.password,
+      name: input.name,
+      callbackURL: "/auth",
+    };
+    target = "sign-up/email";
+    if (env.APP_MODE === "demo") {
+      owner = mailboxCookie(request) ?? randomBytes(32).toString("hex");
+      await pool.query(
+        `insert into auth.demo_mailbox_owner(email, owner_hash)
+        select lower($1),$2 where not exists(select 1 from auth."user" where lower(email)=lower($1)) on conflict(email) do nothing`,
+        [input.email, digest(owner)],
+      );
+    }
+  } else if (path === "password-reset") {
+    body = z.object({ email: z.email() }).strict().parse(raw);
+    target = "request-password-reset";
+  } else if (path === "password-reset/confirm") {
+    body = z
+      .object({
+        token: z.string().min(1).max(500),
+        newPassword: z.string().min(12).max(128),
+      })
+      .strict()
+      .parse(raw);
+    target = "reset-password";
+  } else if (path === "logout") {
+    z.object({}).strict().parse(raw);
+    target = "sign-out";
+  } else throw new DomainError("NOT_FOUND", 404);
+  const headers = new Headers(request.headers);
+  headers.set("content-type", "application/json");
+  const native = await auth.handler(
+    new Request(new URL("/api/auth/" + target, env.APP_URL), {
+      method: "POST",
+      headers,
+      body: JSON.stringify(body),
+    }),
+  );
+  if (path === "password-reset" && native.status === 429)
+    throw new DomainError("RATE_LIMITED", 429);
+  if (native.status >= 500)
+    throw new Error("Authentication transport unavailable");
+  if (path === "password-reset")
+    return response(
+      { message: "Jeśli konto istnieje, wysłaliśmy instrukcję." },
+      202,
+    );
+  if (!native.ok)
+    throw new DomainError(
+      native.status === 429
+        ? "RATE_LIMITED"
+        : path === "login"
+          ? "INVALID_CREDENTIALS_OR_EMAIL_UNVERIFIED"
+          : "AUTH_REQUEST_REJECTED",
+      native.status === 429 ? 429 : path === "login" ? 401 : 422,
+    );
+  const resultBody: unknown = await native
+    .clone()
+    .json()
+    .catch(() => ({}));
+  let result: Response;
+  if (path === "logout") result = empty();
+  else if (path === "register")
+    result = response(
+      {
+        emailVerificationRequired: true,
+        demoMailboxAvailable: env.APP_MODE === "demo",
+      },
+      201,
+    );
+  else if (path === "login") {
+    if (
+      typeof resultBody === "object" &&
+      resultBody !== null &&
+      "twoFactorRedirect" in resultBody &&
+      resultBody.twoFactorRedirect
+    )
+      result = response({ twoFactorRedirect: true });
+    else {
+      const authenticated = new Request(request.url, {
+        headers: cookiesAfter(request.headers, native.headers),
+      });
+      const user = await withPlatform(async (service, repository) =>
+        service.profile(await authenticate(authenticated, repository)),
+      );
+      result = response({ user });
+    }
+  } else result = response({ success: true });
+  for (const value of native.headers.getSetCookie())
+    result.headers.append("set-cookie", value);
+  if (owner)
+    result.headers.append(
+      "set-cookie",
+      `devmentor_demo_mailbox=${owner}; HttpOnly; SameSite=Strict; Path=/; Max-Age=86400`,
+    );
+  return result;
+}
+export async function demoMailbox(request: Request): Promise<Response> {
+  const { env, pool } = getAuthRuntime();
+  // Next may normalize Request.url to the bind address. The transport Host
+  // takes precedence; forwarded host headers never authorize the demo mailbox.
+  const host = request.headers.get("host") ?? new URL(request.url).host;
+  if (
+    env.APP_MODE !== "demo" ||
+    !/^(?:localhost|127\.0\.0\.1|\[::1\])(?::[0-9]{1,5})?$/i.test(host)
+  )
+    throw new DomainError("NOT_FOUND", 404);
+  const owner = mailboxCookie(request);
+  if (!owner) return response([]);
+  const result = await pool.query<{
+    id: string;
+    subject: string;
+    url: string | null;
+    createdAt: string;
+  }>(
+    `select id,subject,url,created_at as "createdAt" from auth.demo_mailbox where owner_hash=$1 order by created_at desc limit 20`,
+    [digest(owner)],
+  );
+  return response(result.rows);
+}
