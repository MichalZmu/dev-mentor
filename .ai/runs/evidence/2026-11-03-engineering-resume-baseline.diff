+test("home exposes product paths and mentor entry points", () => {
+  render(<Home />);
+  expect(screen.getByRole("heading", { level: 1 })).toHaveTextContent(
+    "Twój kolejny",
+  );
+  expect(
+    screen
+      .getAllByRole("link")
