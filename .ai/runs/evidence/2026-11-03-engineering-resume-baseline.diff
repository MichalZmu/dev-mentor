+++ b/packages/app/server/env.ts
@@ -0,0 +1,57 @@
+import "server-only";
+import { z } from "zod";
+
+const schema = z
+  .object({
+    APP_MODE: z.enum(["demo", "production"]).default("production"),
+    APP_URL: z.url().default("http://localhost:3000"),
+    DATABASE_URL: z.string().min(1),
+    AUTH_DATABASE_URL: z.string().optional(),
+    AUTH_SECRET: z.string().min(32).optional(),
+    SMTP_URL: z.string().optional(),
+    OAUTH_GOOGLE_CLIENT_ID: z.string().min(1).optional(),
+    OAUTH_GOOGLE_CLIENT_SECRET: z.string().min(1).optional(),
+    MEETING_BASE_URL: z.url().optional(),
+    EMAIL_FROM: z.string().default("DevMentor <noreply@example.test>"),
+    STRIPE_SECRET_KEY: z.string().optional(),
+    STRIPE_WEBHOOK_SECRET: z.string().optional(),
+    DB_AUTH_POOL_MAX: z.coerce.number().int().min(1).max(20).default(5),
+  })
+  .superRefine((env, context) => {
+    const url = new URL(env.APP_URL);
+    if (
+      Boolean(env.OAUTH_GOOGLE_CLIENT_ID) !==
+      Boolean(env.OAUTH_GOOGLE_CLIENT_SECRET)
+    )
+      context.addIssue({
+        code: "custom",
+        message: "OAuth provider requires paired client credentials.",
+      });
+    if (
+      env.APP_MODE === "production" &&
+      (!env.AUTH_SECRET || url.protocol !== "https:")
+    )
+      context.addIssue({
+        code: "custom",
+        message: "Production requires AUTH_SECRET and HTTPS APP_URL.",
+      });
+    if (
+      env.APP_MODE === "demo" &&
+      !["localhost", "127.0.0.1", "[::1]"].includes(url.hostname)
+    )
+      context.addIssue({
+        code: "custom",
+        message: "Demo requires a loopback APP_URL.",
+      });
+  });
+export type RuntimeEnvironment = z.infer<typeof schema>;
+export function runtimeEnvironment(
+  env: Readonly<Record<string, string | undefined>> = process.env,
+): RuntimeEnvironment {
+  const result = schema.safeParse(env);
+  if (!result.success)
+    throw new Error(
+      "Invalid server configuration. Check required environment variables.",
+    );
+  return result.data;
+}
diff --git a/packages/app/server/http.ts b/packages/app/server/http.ts
new file mode 100644
index 0000000..5f4455d
--- /dev/null
+++ b/packages/app/server/http.ts
@@ -0,0 +1,95 @@
+import "server-only";
+import { randomUUID } from "node:crypto";
+import { z } from "zod";
+import { DomainError } from "@devmentor/core";
+import { logEvent } from "./log";
+
+export function response(data: unknown, status = 200): Response {
+  return Response.json(
+    { data },
+    {
+      status,
+      headers: {
+        "Cache-Control": "no-store",
+        "X-Content-Type-Options": "nosniff",
+      },
+    },
+  );
+}
+export function empty(): Response {
+  return new Response(null, {
+    status: 204,
+    headers: { "Cache-Control": "no-store" },
+  });
+}
+export function errorResponse(
+  error: unknown,
+  requestId: string = randomUUID(),
+): Response {
+  let status = 503;
+  let code = "SERVICE_UNAVAILABLE";
+  let message = "Usługa jest chwilowo niedostępna.";
+  let fieldErrors: Record<string, string[]> | undefined;
+  if (error instanceof DomainError) {
+    status = error.status;
+    code = error.code;
+    message = "Nie można wykonać operacji: " + code;
+  }
+  if (error instanceof z.ZodError) {
+    status = 422;
+    code = "VALIDATION_ERROR";
+    message = "Sprawdź wprowadzone dane.";
+    fieldErrors = {};
+    for (const issue of error.issues) {
+      const key = issue.path.join(".");
+      fieldErrors[key] = ["Nieprawidłowa wartość."];
+    }
+  }
+  if (status >= 500) logEvent("error", "http.request", requestId, code);
+  return Response.json(
+    {
+      error: {
+        code,
+        message,
+        requestId,
+        ...(fieldErrors ? { fieldErrors } : {}),
+      },
+    },
+    {
+      status,
+      headers: {
+        "Cache-Control": "no-store",
+        "X-Request-Id": requestId,
+        ...(status === 429 ? { "Retry-After": "60" } : {}),
+      },
+    },
+  );
+}
+export async function jsonBody(request: Request): Promise<unknown> {
+  if (!request.headers.get("content-type")?.startsWith("application/json"))
+    throw new DomainError("JSON_REQUIRED", 400);
+  if (Number(request.headers.get("content-length")) > 32_768)
+    throw new DomainError("BODY_TOO_LARGE", 413);
+  const body = await request.text();
+  if (Buffer.byteLength(body) > 32_768)
+    throw new DomainError("BODY_TOO_LARGE", 413);
+  try {
+    return JSON.parse(body) as unknown;
+  } catch {
+    throw new DomainError("INVALID_JSON", 400);
+  }
+}
+export function assertOrigin(request: Request, origin: string): void {
+  if (request.headers.get("origin") !== new URL(origin).origin)
+    throw new DomainError("ORIGIN_FORBIDDEN", 403);
+  if (request.headers.get("sec-fetch-site") === "cross-site")
+    throw new DomainError("ORIGIN_FORBIDDEN", 403);
+}
+export function idempotencyKey(request: Request): string {
+  return z
+    .string()
+    .min(8)
+    .max(128)
+    .regex(/^[a-zA-Z0-9_-]+$/)
+    .parse(request.headers.get("idempotency-key"));
+}
